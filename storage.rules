rules_version = '2';
// ArcTrail 3D — regole Storage
// Versione 2026-08-13-listall
//
// CORREZIONE: prima c'era solo "match /market/{userId}/{fileName}".
// Il delete del singolo file funzionava, ma listAll() sulla CARTELLA no:
// in Storage l'elenco viene valutato sul percorso della cartella, e nessuna
// regola corrispondeva a "market/{uid}". Senza elenco, wipeAccountData non
// sapeva quali file cancellare e le foto degli annunci restavano sul cloud
// dopo l'eliminazione dell'account (proprio cio' che Google verifica).
// Ora la cartella ha una sua regola di lettura e i file restano dentro.
service firebase.storage {
  match /b/{bucket}/o {

    // Foto degli annunci del mercatino.
    // Percorso: market/{uid}/{nomefile}.jpg
    match /market/{userId} {

      // Serve per listAll(): l'elenco si valuta su questo livello, non sui file.
      allow read: if request.auth != null;

      match /{fileName} {
        // Chiunque sia loggato può vedere le foto degli annunci
        allow read: if request.auth != null;

        // Solo il proprietario può caricare, max 5 MB, solo immagini
        // (in delete request.resource è nullo, per questo il delete è a parte)
        allow write: if request.auth != null
                     && request.auth.uid == userId
                     && request.resource.size < 5 * 1024 * 1024
                     && request.resource.contentType.matches('image/.*');

        allow delete: if request.auth != null && request.auth.uid == userId;
      }
    }
  }
}
