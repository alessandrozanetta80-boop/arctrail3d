# Dipendenze dei banchi (npm install)
node_modules/

# Fotografie che i banchi scrivono nella radice a ogni giro
/barra-*.png
/schermo-*.png

# Uscite dei generatori, da guardare prima di copiarle a mano
/nuove/
/dizionario.js

# Cache di Python (genera.py carica i dizionari con importlib)
__pycache__/

# I diari che gli emulatori Firebase scrivono nella radice quando gira
# `firebase emulators:exec` (tests/banco-regole.js). Non sono del progetto:
# li riscrive ogni giro, e finiscono in mezzo al `git status` di chi lavora.
/firebase-debug.log
/firestore-debug.log
/ui-debug.log
/database-debug.log
/pubsub-debug.log
